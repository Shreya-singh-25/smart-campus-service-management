                "api",
                "tickets",
                "1"
              ]
            }
          }
        },
        {
          "name": "Update ticket",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/1",
              "host": [
                "{{baseUrl}}"
