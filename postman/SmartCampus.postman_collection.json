                "api",
                "tickets",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fan not working\",\n  \"description\": \"Room 204 fan + light broken\",\n  \"category\": \"HOSTEL_ISSUE\",\n  \"priority\": \"HIGH\",\n  \"location\": \"Hostel B\"\n}"
            }
          }
        },
        {
          "name": "Change status (admin/staff)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
